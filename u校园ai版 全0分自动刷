// ==UserScript==
// @name         U校园(Unipus) 自动跳节+录音+评论+答题 v3.0
// @namespace    unipus-auto-next
// @version      3.0.0
// @description  自动目录跳节(从头到尾)；录音题自动录音；评论题自动发送；选择题/判断题/填空题自动作答；视频/音频自动播放完成
// @match        *://*.unipus.cn/*
// @match        *://*.unipus.com/*
// @include      *://*.unipus.cn/*
// @include      *://*.unipus.com/*
// @noframes
// @run-at       document-start
// @grant        none
// ==/UserScript==

(function () {
  'use strict';

  /* ============ 配置区 ============ */
  const CONFIG = {
    enabled: true,
    scanIntervalMs: 1500,
    recordMinDurationMs: 1000,
    recordMaxWaitMs: 60000,
    settleWaitMs: 2000,
    nextCooldownMs: 4000,
    maxNoProgress: 15,
    autoAnswer: true,
    autoPlayMedia: false,  // 不自动播放媒体（避免卡在视频等待）
    autoFillBlank: true,
    debug: true,
  };

  /* ============ 选择器 ============ */
  const NEXT_PATTERNS = [/下一节/, /下一单元/, /下一部分/, /下一题/, /下一个/, /继续/, /下一页/, /完成本节/, /^next/i, /进入.*学习/, /开始.*学习/];
  const NEXT_EXCLUDE = [/上一/, /重新/, /重录/, /重听/];
  const RECORD_PATTERNS = [/开始录音/, /点击录音/, /^录音$/, /按住.*说话/];
  const STOP_PATTERNS = [/结束录音/, /停止录音/, /^结束$/, /^停止$/, /完成录音/];
  const CONTINUE_PATTERNS = [/下一题/, /下一节/, /继续/, /提交/, /完成/, /查看.*结果/];
  const CLOSE_PATTERNS = [/确定/, /知道了/, /我知道了/, /关闭/, /^知道了$/, /好的/];
  const PLAY_PATTERNS = [/播放/, /^play$/i, /开始播放/, /点击播放/];
  const PLAY_EXCLUDE = [/暂停/, /pause/i, /重新播放/];
  const TRUE_PATTERNS = [/^正确$/, /^对$/, /^true$/i, /^是$/];
  const FALSE_PATTERNS = [/^错误$/, /^错$/, /^false$/i, /^否$/];

  /* ============ 工具 ============ */
  const $ = (s, root = document) => Array.from(root.querySelectorAll(s));

  function elText(el) {
    return (el.innerText || el.textContent || '').trim().replace(/\s+/g, ' ');
  }

  function visible(el) {
    if (!el || !el.isConnected) return false;
    const r = el.getBoundingClientRect();
    if (r.width === 0 && r.height === 0) return false;
    const st = getComputedStyle(el);
    return st.display !== 'none' && st.visibility !== 'hidden';
  }

  function isDisabled(el) {
    if (el.disabled === true) return true;
    if (el.getAttribute && el.getAttribute('aria-disabled') === 'true') return true;
    const c = (el.className && typeof el.className === 'string') ? el.className : '';
    return /disabled|is-disabled/.test(c);
  }

  function findBtn(patterns, exclude = [], root = document) {
    const cands = [];
    $('button,a,[role="button"],[class*="next"],[class*="Next"],[class*="record"],[class*="Record"],[class*="play"],[class*="Play"]', root)
      .forEach((el) => { if (visible(el) && !isDisabled(el) && elText(el).length <= 40) cands.push(el); });
    $('div,span', root).forEach((el) => {
      if (el.children.length === 0 && visible(el) && !isDisabled(el) && elText(el).length <= 12) cands.push(el);
    });
    for (const el of cands) {
      const raw = elText(el);
      if (!raw) continue;
      const t = raw.replace(/\s+/g, '');
      if (!t) continue;
      if (exclude.some((re) => re.test(t))) continue;
      if (patterns.some((re) => re.test(t))) return el;
    }
    return null;
  }

  function fireClick(el) {
    try { el.click(); } catch (e) {}
    try { el.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window })); } catch (e) {}
  }

  function clickDeepest(el) {
    try { el.scrollIntoView({ block: 'center', inline: 'center', behavior: 'auto' }); } catch (e) {}
    let cur = el;
    for (let i = 0; i < 8; i++) {
      const kids = Array.from(cur.children).filter((k) => visible(k));
      if (!kids.length) break;
      const textKids = kids.filter((k) => elText(k).trim().length > 0);
      const next = textKids[0] || kids[0];
      if (next === cur) break;
      cur = next;
    }
    fireClick(cur);
  }

  function clickCenter(el) {
    try { el.scrollIntoView({ block: 'center', inline: 'center', behavior: 'auto' }); } catch (e) {}
    const doClick = () => {
      const r = el.getBoundingClientRect();
      const x = r.left + r.width / 2;
      const y = r.top + r.height / 2;
      let target = el;
      try {
        const t = document.elementFromPoint(x, y);
        if (t && el.contains(t)) target = t;
      } catch (e) {}
      const opts = { bubbles: true, cancelable: true, view: window };
      try { target.dispatchEvent(new MouseEvent('mousedown', opts)); } catch (e) {}
      try { target.dispatchEvent(new MouseEvent('mouseup', opts)); } catch (e) {}
      fireClick(target);
    };
    requestAnimationFrame(() => requestAnimationFrame(doClick));
  }

  /* ============ 状态机 ============ */
  const S = { IDLE: 0, RECORDING: 1, WAITING: 2, SETTLE: 3, PLAYING_MEDIA: 4 };
  let state = S.IDLE;
  let recordStart = 0;
  let recordIdx = 0;
  let lastNextClick = 0;
  let noProgress = 0;
  let lastSnapshot = '';
  let lastAction = '等待扫描…';
  let mediaWaitUntil = 0;

  function domSnapshot() {
    const root = document.getElementById('root');
    if (!root) return '';
    let mediaInfo = '';
    $('video,audio', document).forEach((m) => {
      mediaInfo += '|' + Math.round(m.currentTime || 0) + '/' + Math.round(m.duration || 0) + (m.paused ? 'p' : 'r');
    });
    return root.innerHTML.length + ':' + (root.querySelector('[class*="question"], [class*="Question"]') ? 'q' : '') + mediaInfo;
  }

  /* ============ 日志面板 ============ */
  const panel = document.createElement('div');
  panel.id = 'unipusPanel';
  panel.style.cssText = 'position:fixed;right:16px;bottom:16px;z-index:999999;width:320px;font:12px/1.6 monospace;background:#1f2430;color:#cfd6e4;border:1px solid #333;border-radius:8px;padding:10px;box-shadow:0 4px 20px rgba(0,0,0,.4);';
  panel.innerHTML =
    '<div id="unipusHeader" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;cursor:move">' +
    '<b style="color:#7cc0ff">U校园自动机 v2</b>' +
    '<label style="display:flex;align-items:center;gap:4px;cursor:pointer"><input type="checkbox" id="unipusToggle" ' + (CONFIG.enabled ? 'checked' : '') + '>运行</label></div>' +
    '<div id="unipusStatus" style="color:#7ee787">状态: 等待扫描…</div>' +
    '<div id="unipusLog" style="max-height:180px;overflow:auto;margin-top:6px;white-space:pre-wrap;color:#aab4c3;user-select:text;-webkit-user-select:text"></div>' +
    '<div style="display:flex;justify-content:space-between;margin-top:6px;color:#666">' +
    '<span id="unipusDebug" style="cursor:pointer;text-decoration:underline">探查: ' + (CONFIG.debug ? '开' : '关') + '</span>' +
    '<span id="unipusCopy" style="cursor:pointer;text-decoration:underline">复制日志</span></div>';

  const start = () => {
    document.body.appendChild(panel);
    setInterval(tick, CONFIG.scanIntervalMs);

    let dragOff = null;
    panel.querySelector('#unipusHeader').addEventListener('mousedown', (e) => {
      dragOff = { dx: e.clientX - panel.offsetLeft, dy: e.clientY - panel.offsetTop };
      e.preventDefault();
    });
    document.addEventListener('mousemove', (e) => {
      if (!dragOff) return;
      panel.style.left = (e.clientX - dragOff.dx) + 'px';
      panel.style.top = (e.clientY - dragOff.dy) + 'px';
      panel.style.right = 'auto';
      panel.style.bottom = 'auto';
    });
    document.addEventListener('mouseup', () => { dragOff = null; });

    panel.querySelector('#unipusToggle').addEventListener('change', (e) => {
      CONFIG.enabled = e.target.checked;
      if (CONFIG.enabled) { noProgress = 0; lastSnapshot = ''; setState(S.IDLE); log('▶ 已启动'); }
      else { log('⏸ 已暂停'); }
    });
    panel.querySelector('#unipusDebug').addEventListener('click', () => {
      CONFIG.debug = !CONFIG.debug;
      panel.querySelector('#unipusDebug').textContent = '探查: ' + (CONFIG.debug ? '开' : '关');
      log(CONFIG.debug ? '探查模式开启' : '探查模式关闭');
    });
    panel.querySelector('#unipusCopy').addEventListener('click', () => {
      const txt = logEl.textContent;
      const done = () => { panel.querySelector('#unipusCopy').textContent = '已复制 ✓'; setTimeout(() => { panel.querySelector('#unipusCopy').textContent = '复制日志'; }, 1500); };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(txt).then(done).catch(() => fallbackCopy(txt, done));
      } else { fallbackCopy(txt, done); }
    });

    function fallbackCopy(txt, done) {
      const ta = document.createElement('textarea');
      ta.value = txt;
      ta.style.cssText = 'position:fixed;left:-9999px;top:0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); done(); } catch (e) { log('复制失败'); }
      document.body.removeChild(ta);
    }

    log('v2.0 已加载：跳节+录音+视频+答题，等待扫描…');
  };
  const statusEl = panel.querySelector('#unipusStatus');
  const logEl = panel.querySelector('#unipusLog');

  function log(msg) {
    const t = new Date().toTimeString().slice(0, 8);
    logEl.textContent = (t + ' ' + msg + '\n' + logEl.textContent).slice(0, 3000);
    lastAction = msg;
    statusEl.textContent = '状态: ' + msg;
  }
  function setState(s) {
    if (!CONFIG.enabled) { state = S.IDLE; return; }
    state = s;
    if (s === S.IDLE) statusEl.textContent = '状态: 等待扫描…';
  }

  if (CONFIG.debug) {
    document.addEventListener('click', (e) => {
      if (!e.isTrusted) return;
      const el = e.target;
      if (el.closest && el.closest('#unipusPanel')) return;
      const t = el.tagName.toLowerCase();
      const cls = (el.className && typeof el.className === 'string') ? el.className.slice(0, 80) : '';
      const txt = elText(el).slice(0, 30);
      log('[探查] <' + t + ' class="' + cls + '" 文本="' + txt + '">');
    }, true);
  }

  /* ============ 视频/音频自动播放 ============ */
  function findMediaElements() {
    return $('video,audio', document).filter((el) => visible(el) || el.tagName === 'AUDIO');
  }

  function findPlayButton() {
    const byText = findBtn(PLAY_PATTERNS, PLAY_EXCLUDE, document);
    if (byText) return byText;
    const playBtns = $('button,[role="button"],[class*="play"],[class*="Play"],[class*="video"],[class*="Video"]', document)
      .filter((el) => visible(el) && !isDisabled(el))
      .filter((el) => el.querySelector('svg') || /play|播放/i.test(elText(el)));
    if (playBtns.length) {
      playBtns.sort((a, b) => {
        const ra = a.getBoundingClientRect();
        const rb = b.getBoundingClientRect();
        return (rb.width * rb.height) - (ra.width * ra.height);
      });
      return playBtns[0];
    }
    return null;
  }

  function hasMediaToPlay() {
    if (!CONFIG.autoPlayMedia) return false;
    const media = findMediaElements();
    if (!media.length) return false;
    return media.some((m) => {
      const dur = m.duration || 0;
      const cur = m.currentTime || 0;
      return dur === 0 || cur < dur - 1;
    });
  }

  function tryPlayMedia() {
    if (!CONFIG.autoPlayMedia) return false;
    const media = findMediaElements();
    if (!media.length) return false;
    let played = false;
    for (const m of media) {
      if (m.paused) {
        try {
          const p = m.play();
          if (p && p.then) {
            p.then(() => {
              log('▶ 媒体开始播放');
            }).catch(() => {
              const btn = findPlayButton();
              if (btn) { log('▶ 点击播放按钮'); clickCenter(btn); }
            });
          }
          played = true;
        } catch (e) {
          const btn = findPlayButton();
          if (btn) { log('▶ 点击播放按钮'); clickCenter(btn); played = true; }
        }
      }
    }
    if (!played) {
      const btn = findPlayButton();
      if (btn) { log('▶ 点击播放按钮'); clickCenter(btn); played = true; }
    }
    if (played) {
      const m = media[0];
      const dur = m.duration || 0;
      if (dur > 0) {
        const waitMs = Math.ceil(dur * 1000) + 3000;
        mediaWaitUntil = Date.now() + waitMs;
        log('⏳ 等待视频播放 (' + Math.round(dur) + 's)');
      } else {
        mediaWaitUntil = Date.now() + 30000;
        log('⏳ 等待视频播放 (时长未知, 等30s)');
      }
    }
    return played;
  }

  function allMediaEnded() {
    const media = findMediaElements();
    if (!media.length) return true;
    return media.every((m) => {
      const dur = m.duration || 0;
      const cur = m.currentTime || 0;
      return dur > 0 && cur >= dur - 0.5;
    });
  }

  /* ============ 评论/讨论题（文本输入+发送） ============ */
  // 评论提交按钮：必须是明确的动作按钮，不能是列表标题/排序选项等
  // 只匹配 "发布/发表/发送" 这类动词开头的短按钮，不匹配"全部评论""倒序"等
  const COMMENT_SUBMIT_PATTERNS = [/^发布$/, /^发表$/, /^发送$/, /^发表评论$/, /^发布评论$/, /^submit$/i, /^post$/i];
  const COMMENT_EXCLUDE = [/取消/, /删除/, /编辑/, /举报/, /全部评论/, /倒序/, /正序/, /条/, /排序/];

  // 检测是否在评论/讨论区：有可见输入框 且 有真正的发布按钮
  // 注意：不通过"录音文字"排除，因为评论区页面本身可能包含"录音"相关提示文字
  // 录音题的排除逻辑放在 findRecordButton / recordHintVisible 中处理
  function isCommentArea() {
    // 1) 页面上有可见的文本输入框（含 contenteditable）
    const inputs = findCommentInputs();
    if (!inputs.length) return false;
    // 2) 同时有真正的"发布/发送"按钮（排除列表标题等）
    const submitBtn = findCommentSubmitBtn();
    if (!submitBtn) return false;
    // 3) 确认是评论区而非录音题：评论区没有口语题的录音布局
    //    只检查是否存在录音题特有的 DOM 结构，不检查文字
    const hasRecordLayout = !!document.querySelector(
      '.question-abs-question,[class*="question-abs"],.reply-wrap,[class*="reply-wrap"]'
    );
    // 如果有口语题布局且有录音按钮类名，不是评论区
    const hasRecordBtn = !!document.querySelector(
      '[class*="record-button"],[class*="ucomp-recorder"],[class*="voice-recorder"]'
    );
    if (hasRecordLayout && hasRecordBtn) return false;
    return true;
  }

  // 查找评论输入框：input/textarea/contenteditable，排除搜索框等
  function findCommentInputs() {
    return $('input[type="text"],input:not([type]),textarea,[contenteditable="true"]', document)
      .filter(visible)
      .filter((el) => !isDisabled(el))
      .filter((el) => {
        // 排除搜索框、分页跳转框等
        const ph = (el.getAttribute && el.getAttribute('placeholder')) || '';
        if (/搜索|search|跳转|页码/i.test(ph)) return false;
        // 排除太小的输入框（可能是个隐藏的辅助元素）
        const r = el.getBoundingClientRect();
        if (r.width < 30 || r.height < 15) return false;
        return true;
      });
  }

  // 查找真正的评论提交按钮：文字是"发布/发表/发送"且是短文本按钮
  function findCommentSubmitBtn() {
    const cands = [];
    $('button,[role="button"]', document)
      .forEach((el) => { if (visible(el) && !isDisabled(el) && elText(el).length <= 10) cands.push(el); });
    for (const el of cands) {
      const raw = elText(el);
      if (!raw) continue;
      const t = raw.replace(/\s+/g, '');
      if (!t) continue;
      if (COMMENT_EXCLUDE.some((re) => re.test(t))) continue;
      if (COMMENT_SUBMIT_PATTERNS.some((re) => re.test(t))) return el;
    }
    return null;
  }

  // 通用输入函数：兼容 React/antd 的 Input 和 TextArea
  // 关键：用 native setter 设值 + InputEvent(不是Event) 触发 React 识别
  function simulateInput(el, text) {
    try {
      el.focus();
      el.click();
      // 方式1：native value setter + InputEvent（React 能识别）
      const proto = el.tagName === 'TEXTAREA' ? window.HTMLTextAreaElement.prototype : window.HTMLInputElement.prototype;
      const setter = Object.getOwnPropertyDescriptor(proto, 'value');
      if (setter && setter.set) {
        setter.set.call(el, text);
      } else {
        el.value = text;
      }
      // InputEvent 是 React 识别的关键，普通 Event 不行
      el.dispatchEvent(new InputEvent('input', { bubbles: true, data: text, inputType: 'insertText' }));
      el.dispatchEvent(new InputEvent('change', { bubbles: true }));
      // 方式2：再兜底用 document.execCommand 模拟键盘输入
      try {
        el.focus();
        const sel = window.getSelection ? window.getSelection() : null;
        if (sel) {
          const range = document.createRange();
          range.selectNodeContents(el);
          range.collapse(false);
          sel.removeAllRanges();
          sel.addRange(range);
        }
        document.execCommand('selectAll', false, null);
        document.execCommand('insertText', false, text);
      } catch (e) {}
      return true;
    } catch (e) { return false; }
  }

  // 评论题：在输入框填入 "."
  let commentFilled = false;
  let lastCommentSentAt = 0;
  function fillComment() {
    const inputs = findCommentInputs();
    const empty = inputs.filter((el) => {
      if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') return !el.value;
      return !elText(el);
    });
    if (!empty.length) { commentFilled = true; return false; }
    let filled = false;
    for (const inp of empty) {
      if (simulateInput(inp, '.')) filled = true;
    }
    if (filled) {
      log('💬 评论题: 输入 "." 准备发送');
      commentFilled = true;
      lastQuizAction = Date.now();
      return true;
    }
    return false;
  }

  // 发送评论：点击"发布"按钮——即使 disabled 也尝试点（可能刚输入完 React 还没更新）
  function submitComment() {
    // 找按钮（包括 disabled 状态的）
    const btns = $('button,[role="button"]', document).filter(visible);
    let btn = null;
    for (const el of btns) {
      const t = elText(el).replace(/\s+/g, '');
      if (!t || t.length > 10) continue;
      if (COMMENT_EXCLUDE.some((re) => re.test(t))) continue;
      if (COMMENT_SUBMIT_PATTERNS.some((re) => re.test(t))) { btn = el; break; }
    }
    if (!btn) return false;
    // 检查输入框是否有内容
    const inputs = findCommentInputs();
    const hasContent = inputs.some((el) => {
      if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') return !!el.value;
      return !!elText(el).trim();
    });
    if (!hasContent) { log('💬 输入框为空，先填入'); return false; }
    // 检查按钮是否 disabled
    const cls = (btn.className || '').toString();
    if (/disabled/.test(cls)) {
      // 按钮还 disabled，说明 React 还没识别到输入，再触发一次 input 事件
      log('💬 发布按钮还 disabled，重新触发 input');
      for (const inp of inputs) {
        if (inp.tagName === 'TEXTAREA' || inp.tagName === 'INPUT') {
          inp.dispatchEvent(new InputEvent('input', { bubbles: true, data: '.', inputType: 'insertText' }));
        }
      }
      return false; // 下轮再试
    }
    log('💬 发送评论: "' + elText(btn) + '"');
    clickCenter(btn);
    commentFilled = false;
    return true;
  }

  /* ============ 录音 ============ */
  function recordHintVisible() {
    const body = document.body;
    if (!body) return false;
    // 排除评论/讨论区：如果当前是评论题，不识别为录音题
    if (isCommentArea()) return false;
    // 文字提示必须明确包含"录音"二字，排除"请录音后发表评论"等评论题提示
    // 要求同时有录音相关按钮和口语题布局
    const hasQ = !!document.querySelector('.question-abs-question,[class*="question-abs"]');
    const hasReply = !!document.querySelector('.reply-wrap,[class*="reply-wrap"],[class*="layout-reply"],[class*="layoutBody"]');
    // 精确匹配录音相关类名，排除 record-input/record-form 等评论区的类名
    const hasMic = !!document.querySelector('[class*="record-button"],[class*="record-icon"],[class*="ucomp-recorder"],[class*="voice-recorder"]');
    if (hasQ && hasReply && hasMic) return true;
    // 文字兜底：只在有口语题布局时才检查文字提示
    // 不直接扫描整页文字（避免评论区"请录音后发表评论"等文字误判）
    if (hasQ || hasReply) {
      // 在口语题区域内检查文字提示
      const qEl = document.querySelector('.question-abs-question,[class*="question-abs"],.reply-wrap,[class*="reply-wrap"],[class*="layout-reply"],[class*="layoutBody"]');
      if (qEl) {
        const qText = qEl.innerText || '';
        if (/开始录音|点击录音|按住.*说话|record your answer/i.test(qText)) return true;
      }
    }
    return false;
  }

  const RECORD_BLACKLIST = [/browser/i, /不支持/i, /don.?t support/i, /doesn.?t support/i, /allow/i, /请允许/, /权限/];

  function findRecordButton() {
    // 评论/讨论区不识别为录音题（即使页面有"录音"文字也不行）
    if (isCommentArea()) return null;
    // 文字匹配录音按钮时，排除评论区中的提示文字
    // 只在非评论区域查找录音按钮文字
    const byText = findBtn(RECORD_PATTERNS, [], document);
    if (byText) {
      // 二次确认：找到的按钮不在评论区附近
      const commentInput = findCommentInputs();
      if (commentInput.length > 0 && byText.closest('[class*="comment"],[class*="Comment"],[class*="reply"],[class*="Reply"]')) {
        return null; // 这个"录音"按钮在评论区，不识别为录音题
      }
      return byText;
    }
    if (!recordHintVisible()) return null;
    let recBtns = $('button,[role="button"],[class*="record"],[class*="Record"],[class*="recorder"],[class*="Recorder"],[class*="mic"],[class*="Mic"],[class*="voice"],[class*="Voice"]', document)
      .filter((el) => visible(el) && el.querySelector('svg'))
      .map((el) => ({ el: el, r: el.getBoundingClientRect(), depth: el.querySelectorAll('*').length }))
      .filter((o) => o.r.width >= 20 && o.r.width <= 260 && o.r.height >= 20 && o.r.height <= 260)
      .sort((a, b) => (a.depth - b.depth) || ((a.r.width * a.r.height) - (b.r.width * b.r.height)));
    if (recBtns.length) {
      if (recordIdx >= recBtns.length) recordIdx = 0;
      return recBtns[recordIdx].el;
    }
    recordIdx = 0;
    return null;
  }

  function findStopButton() {
    const byText = findBtn(STOP_PATTERNS, [], document);
    if (byText) return byText;
    if (recordHintVisible()) return findRecordButton();
    return null;
  }

  /* ============ Tab 切换 ============ */
  const TAB_NAME_RE = /(before|while|after) you (watch|listen)/i;

  function findOddOne(arr) {
    const count = {};
    arr.forEach((c) => { count[c] = (count[c] || 0) + 1; });
    const entries = Object.entries(count).sort((a, b) => b[1] - a[1]);
    if (!entries.length || entries[0][1] <= 1) return -1;
    const majority = entries[0][0];
    return arr.findIndex((c) => c !== majority);
  }

  function findActiveTab(tabs) {
    for (const el of tabs) {
      const c = (el.className || '').toString();
      if (/(^|[\s_-])active($|[\s_-])|current|selected|checked/i.test(c)) return el;
      if (el.getAttribute && el.getAttribute('aria-selected') === 'true') return el;
    }
    const bgColors = tabs.map((el) => { try { return getComputedStyle(el).backgroundColor; } catch (e) { return ''; } });
    const oddBg = findOddOne(bgColors);
    if (oddBg >= 0) return tabs[oddBg];
    const fgColors = tabs.map((el) => { try { return getComputedStyle(el).color; } catch (e) { return ''; } });
    const oddFg = findOddOne(fgColors);
    return oddFg >= 0 ? tabs[oddFg] : null;
  }

  function clickNextTab() {
    const tabSel = '.pc-tab-view-container,[class*="tab"],[class*="Tab"],[role="tab"]';
    let tabs = $(tabSel, document)
      .filter((el) => visible(el) && TAB_NAME_RE.test(elText(el)) && elText(el).length <= 30);
    tabs = tabs.filter((el) => !tabs.some((other) => other !== el && other.contains(el)));
    if (tabs.length < 2) return false;
    const active = findActiveTab(tabs);
    if (!active) return false;
    const idx = tabs.indexOf(active);
    if (idx < 0 || idx >= tabs.length - 1) return false;
    const now = Date.now();
    if (now - lastNextClick < CONFIG.nextCooldownMs) return false;
    lastNextClick = now;
    const next = tabs[idx + 1];
    log('🗂 切换小分节: "' + elText(next).slice(0, 20) + '"');
    clickDeepest(next);
    return true;
  }

  /* ============ 侧边栏菜单导航 ============ */
  // 跳过非任务菜单项：学习目标、目录、笔记、讨论、资料
  // 注意：不跳过 "Get on board" 等活动题
  const MENU_SKIP = [/learning\s*objectives/i, /^目录$/, /^笔记$/, /^讨论$/, /^资料$/, /^新未来/, /^Person to person$/, /条\/页/, /跳至/, /共.*条/];

  function isBlueColor(colorStr) {
    const m = /rgba?\((\d+),\s*(\d+),\s*(\d+)/.exec(colorStr || '');
    if (!m) return false;
    const r = +m[1], g = +m[2], b = +m[3];
    return b > 120 && b > r + 40 && b >= g;
  }

  function elementColor(ind) {
    let color = '';
    try {
      if (ind.tagName.toLowerCase() === 'svg') {
        const p = ind.querySelector('path,circle,ellipse,rect,polygon') || ind;
        color = getComputedStyle(p).fill;
        if (!color || color === 'none') {
          color = getComputedStyle(p).stroke;
          if (!color || color === 'none') color = getComputedStyle(ind).color;
        }
      } else {
        const bg = getComputedStyle(ind).backgroundColor;
        color = (bg && bg !== 'rgba(0, 0, 0, 0)') ? bg : getComputedStyle(ind).color;
      }
    } catch (e) {}
    return color;
  }

  function pseudoBg(el, pseudo) {
    try {
      const bg = getComputedStyle(el, pseudo).backgroundColor;
      return (bg && bg !== 'rgba(0, 0, 0, 0)') ? bg : '';
    } catch (e) { return ''; }
  }

  // 检测菜单项的完成状态
  // 真实DOM: <span class="pc-menu-node-name"> 在 <div class="pc-slider-menu-micro pc-menu-default/activity">
  // 完成状态检测策略：
  //   1) 检查父容器及祖先类名是否含 done/complete/finish 等
  //   2) 检查菜单项左侧圆形指示器颜色（蓝色=已完成）
  //   3) 检查 ::before/::after 伪元素背景色
  //   4) 检查祖先元素的边框颜色
  function circleState(nameSpan) {
    // 首先检查父容器 pc-slider-menu-micro 的类名
    let container = nameSpan.closest('[class*="pc-slider-menu"]') || nameSpan.parentElement;
    for (let i = 0; i < 8 && container; i++) {
      const cCls = (container.className || '').toString();
      // 明确的完成状态类名
      if (/done|complete|finish|passed|success|finished/i.test(cCls)) return 'done';
      if (/todo|pending|undo|current|active/i.test(cCls)) {
        // 有 active/current 但无 done → 可能是当前活动项
        if (!/done|complete/i.test(cCls)) return 'todo';
      }
      // 检查菜单项左侧的圆形指示器（可能在兄弟节点或子节点）
      const ind = container.querySelector('svg,[class*="circle"],[class*="Circle"],[class*="icon"],[class*="Icon"],[class*="radio"],[class*="Radio"],[class*="status"],[class*="Status"],[class*="progress"],[class*="Progress"],[class*="dot"],[class*="Dot"],[class*="step"],[class*="Step"]');
      if (ind) {
        const c = elementColor(ind);
        if (c) return isBlueColor(c) ? 'done' : 'todo';
      }
      // 检查伪元素
      for (const el of [container, nameSpan]) {
        const pbg1 = pseudoBg(el, '::before');
        if (pbg1) return isBlueColor(pbg1) ? 'done' : 'todo';
        const pbg2 = pseudoBg(el, '::after');
        if (pbg2) return isBlueColor(pbg2) ? 'done' : 'todo';
      }
      // 检查边框
      const bc = borderBlue(container);
      if (bc) return 'done';
      container = container.parentElement;
    }
    return 'unknown';
  }

  function borderBlue(el) {
    try {
      const st = getComputedStyle(el);
      for (const side of ['borderTopColor', 'borderBottomColor', 'borderLeftColor', 'borderRightColor']) {
        const c = st[side];
        if (c && c !== 'rgba(0, 0, 0, 0)' && isBlueColor(c)) return c;
      }
    } catch (e) {}
    return '';
  }

  // 检测当前激活的菜单项
  // 真实DOM: 当前活动的菜单项父容器是 pc-menu-activity（非 pc-menu-default）
  function isCurrentRow(row, name) {
    try {
      // 方式1: 检查父容器类名是否含 active/current/pc-menu-activity
      let container = name.closest('[class*="pc-slider-menu"]') || name.parentElement;
      for (let i = 0; i < 5 && container; i++) {
        const c = (container.className || '').toString();
        if (/pc-menu-activity|active|current|selected/i.test(c)) return true;
        container = container.parentElement;
      }
      // 方式2: 检查背景色是否为蓝色（当前项高亮）
      for (const el of [row, name]) {
        const bg = getComputedStyle(el).backgroundColor;
        if (!bg || bg === 'rgba(0, 0, 0, 0)') continue;
        const m = /rgba?\((\d+),\s*(\d+),\s*(\d+)/.exec(bg);
        if (!m) continue;
        const r = +m[1], g = +m[2], b = +m[3];
        if (b > 180 && b > r + 30 && b >= g) return true;
      }
      // 方式3: 检查 ::before 伪元素（左侧蓝色条）
      const pbg = pseudoBg(name, '::before');
      if (pbg && isBlueColor(pbg)) return true;
      const pbg2 = pseudoBg(name.parentElement || name, '::before');
      if (pbg2 && isBlueColor(pbg2)) return true;
    } catch (e) {}
    return false;
  }

  function contentHeadings() {
    return $('h1,h2,h3,.section-title,[class*="title"],[class*="Title"]', document)
      .filter(visible)
      .map((el) => elText(el).replace(/\s+/g, ''))
      .filter((s) => s && s.length <= 30);
  }

  let lastMenuTarget = { text: '', at: 0 };
  let triedMenuItems = {}; // 记录已尝试过的菜单项，防止重复点击同一个
  let menuSeq = []; // 缓存菜单项顺序，确保从头到尾遍历

  // 获取侧边栏菜单项列表（按 DOM 顺序）
  // 真实DOM: <span class="pc-menu-node-name"> 在 <div class="pc-slider-menu-micro pc-menu-default/activity">
  function getMenuItems() {
    // 优先使用精确的 pc-menu-node-name 选择器
    let names = $('.pc-menu-node-name', document).filter(visible);
    // 兜底：如果精确选择器没找到，用宽泛的选择器
    if (!names.length) {
      names = $('[class*="node-name"],[class*="menu-item-name"],[class*="section-name"],[class*="item-name"]', document).filter(visible);
    }
    const items = [];
    for (const name of names) {
      const t = elText(name).replace(/\s+/g, '');
      if (!t) continue;
      // 跳过非任务项
      if (MENU_SKIP.some((re) => re.test(t))) continue;
      // 跳过分页项（ant-pagination 中的 LI）
      const parent = name.closest('.ant-pagination,[class*="pagination"]');
      if (parent) continue;
      // 跳过面包屑导航
      if (name.closest('[class*="breadcrumb"],[class*="Breadcrumb"]')) continue;
      // 获取父容器（pc-slider-menu-micro）
      const container = name.closest('[class*="pc-slider-menu"]') || name.parentElement;
      items.push({
        name: name,
        text: t,
        state: circleState(name),
        current: isCurrentRow(container, name),
        container: container,
      });
    }
    return items;
  }

  function clickNextMenuItem() {
    const now = Date.now();
    if (now - lastNextClick < CONFIG.nextCooldownMs) return false;
    if (lastMenuTarget.text && now - lastMenuTarget.at < 15000) return false;

    const items = getMenuItems();
    if (!items.length) {
      log('⚠ 未找到菜单项');
      return false;
    }

    // 调试日志：列出所有菜单项状态
    if (CONFIG.debug) {
      const summary = items.map((it) => {
        const flag = it.current ? '👉' : (it.state === 'done' ? '✅' : '⬜');
        return flag + it.text.slice(0, 15);
      }).join(' | ');
      log('📋 菜单: ' + summary);
    }

    // 找当前激活项的索引
    const curIdx = items.findIndex((it) => it.current);

    // 策略1: 如果有当前项，从下一项开始找未完成且未尝试过的
    const start = curIdx >= 0 ? curIdx + 1 : 0;
    for (let i = start; i < items.length; i++) {
      const it = items[i];
      if (it.state === 'done') continue;
      // 跳过最近 60 秒内已尝试过的菜单项（防止来回跳）
      if (triedMenuItems[it.text] && now - triedMenuItems[it.text] < 60000) continue;
      lastNextClick = now;
      lastMenuTarget = { text: it.text, at: now };
      triedMenuItems[it.text] = now;
      log('🗂 菜单跳转: "' + it.text.slice(0, 20) + '" (状态=' + it.state + ')');
      clickCenter(it.name);
      return true;
    }

    // 策略2: 如果后面都尝试过了或已完成，从头找未尝试过的
    for (let i = 0; i < start && i < items.length; i++) {
      const it = items[i];
      if (it.state === 'done') continue;
      if (triedMenuItems[it.text] && now - triedMenuItems[it.text] < 60000) continue;
      lastNextClick = now;
      lastMenuTarget = { text: it.text, at: now };
      triedMenuItems[it.text] = now;
      log('🗂 菜单跳转(从头): "' + it.text.slice(0, 20) + '" (状态=' + it.state + ')');
      clickCenter(it.name);
      return true;
    }

    // 策略3: 所有项都已尝试过或完成，找第一个状态非 done 的重试
    for (const it of items) {
      if (it.state === 'done') continue;
      // 重置该项的尝试记录，允许重试
      delete triedMenuItems[it.text];
      lastNextClick = now;
      lastMenuTarget = { text: it.text, at: now };
      triedMenuItems[it.text] = now;
      log('🗂 菜单跳转(重试): "' + it.text.slice(0, 20) + '" (状态=' + it.state + ')');
      clickCenter(it.name);
      return true;
    }

    log('✅ 所有菜单项已完成');
    return false;
  }

  /* ============ 点击操作 ============ */
  function clickNext() {
    const btn = findBtn(NEXT_PATTERNS, NEXT_EXCLUDE);
    if (!btn) return false;
    const now = Date.now();
    if (now - lastNextClick < CONFIG.nextCooldownMs) return false;
    lastNextClick = now;
    log('👉 点击下一节: "' + elText(btn).slice(0, 15) + '"');
    clickDeepest(btn);
    return true;
  }

  function clickRecord() {
    const btn = findRecordButton();
    if (!btn) return false;
    log('🎙 开始录音: "' + elText(btn).slice(0, 15) + '"');
    clickCenter(btn);
    return true;
  }

  function clickStop() {
    const btn = findStopButton();
    if (!btn) return false;
    log('⏹ 结束录音: "' + elText(btn).slice(0, 15) + '"');
    clickCenter(btn);
    return true;
  }

  function clickContinue() {
    const btn = findBtn(CONTINUE_PATTERNS, NEXT_EXCLUDE, document);
    if (!btn) return false;
    log('➡ 继续: "' + elText(btn).slice(0, 15) + '"');
    clickDeepest(btn);
