  }

  function closeDialogs() {
    const modals = $('.ant-modal,[class*="modal"],[class*="Modal"],[class*="dialog"],[class*="Dialog"],[class*="popup"],[class*="Popup"]', document).filter(visible);
    if (modals.length) {
      const btn = findBtn(CLOSE_PATTERNS, [], modals[modals.length - 1]);
      if (btn && /确定|知道了|我知道了|好的/.test(elText(btn))) {
        log('✖ 关闭弹窗: "' + elText(btn).slice(0, 12) + '"');
        clickCenter(btn);
        return true;
      }
    }
    const btn2 = findBtn(CLOSE_PATTERNS, [], document);
    if (btn2 && /确定|知道了|我知道了|好的/.test(elText(btn2))) {
      log('✖ 关闭弹窗(兜底): "' + elText(btn2).slice(0, 12) + '"');
      clickCenter(btn2);
      return true;
    }
    return false;
  }

  function findConfirmDialog() {
    const modals = $('.ant-modal,[class*="modal"],[class*="Modal"],[class*="dialog"],[class*="Dialog"]', document).filter(visible);
    for (const m of modals) {
      const t = elText(m).replace(/\s+/g, '');
      if (/确认.*(提交|作答)|没有作答|未作答|还有\d+道题|确认要提交/.test(t)) return m;
    }
    return null;
  }

  /* ============ 答题逻辑 ============ */
  let lastQuizAction = 0;

  function answerQuiz() {
    if (!CONFIG.autoAnswer) return false;
    const now = Date.now();
    if (now - lastQuizAction < 3000) return false;

    const optSel = '.ant-radio-wrapper,[class*="option"],[class*="Option"],[class*="choice"],[class*="Choice"],[class*="answer"],[class*="Answer"],.ant-checkbox-wrapper';
    const opts = $(optSel, document).filter(visible).filter((el) => {
      const c = (el.className || '').toString().toLowerCase();
      const t = elText(el).replace(/\s+/g, '');
      if (/ant-select/.test(c)) return false;
      if (/条\/页|跳至|共.*条/.test(t)) return false;
      if (/客观题|主观题|正确|部分正确|得分/.test(t)) return false;
      if (!t) return false;
      return true;
    });

    // 判断题
    const hasTrue = opts.some((el) => TRUE_PATTERNS.some((re) => re.test(elText(el).replace(/\s+/g, ''))));
    const hasFalse = opts.some((el) => FALSE_PATTERNS.some((re) => re.test(elText(el).replace(/\s+/g, ''))));
    if (hasTrue && hasFalse && opts.length === 2) {
      const selected = opts.find((el) => /active|selected|checked|choosed|current/i.test((el.className || '').toString()));
      if (!selected) {
        const trueOpt = opts.find((el) => TRUE_PATTERNS.some((re) => re.test(elText(el).replace(/\s+/g, ''))));
        if (trueOpt) {
          log('☑ 判断题: 选择"正确"');
          clickDeepest(trueOpt);
          lastQuizAction = Date.now();
          return true;
        }
      }
    }

    if (opts.length === 0) {
      // 填空题
      return fillBlanks();
    }
    const selected = opts.find((el) => /active|selected|checked|choosed|current/i.test((el.className || '').toString()));
    const submitBtn = findBtn([/提交/, /确\s*定/, /submit/i], [], document);
    if (!selected) {
      const first = opts[0];
      log('🔘 选择题: 点击第一个选项 "' + elText(first).slice(0, 20) + '"');
      clickDeepest(first);
      lastQuizAction = Date.now();
      return true;
    }
    if (submitBtn) {
      log('✅ 选择题: 提交答案');
      clickDeepest(submitBtn);
      lastQuizAction = Date.now();
      return true;
    }
    return false;
  }

  function fillBlanks() {
    if (!CONFIG.autoFillBlank) return false;
    const inputs = $('input[type="text"],input:not([type]),textarea', document)
      .filter(visible)
      .filter((el) => !isDisabled(el) && !el.value);
    if (inputs.length === 0) return false;
    let filled = false;
    for (const inp of inputs) {
      if (simulateInput(inp, 'a')) filled = true;
    }
    if (filled) {
      log('✏ 填空题: 已填入 "a"');
      lastQuizAction = Date.now();
      // 下一轮尝试提交
      return true;
    }
    return false;
  }

  /* ============ 核心状态机 ============ */
  function tick() {
    if (!CONFIG.enabled) { setState(S.IDLE); return; }

    // 防死循环：DOM 一直不变 → 暂停
    const snap = domSnapshot();
    if (snap === lastSnapshot && (state === S.IDLE || state === S.SETTLE)) {
      noProgress++;
      if (noProgress > CONFIG.maxNoProgress) {
        log('⚠ 连续无变化，暂停自动运行（请检查页面）');
        CONFIG.enabled = false;
        panel.querySelector('#unipusToggle').checked = false;
        noProgress = 0;
        return;
      }
    } else {
      noProgress = 0;
    }
    lastSnapshot = snap;

    // 弹窗处理
    if (closeDialogs()) { lastSnapshot = ''; return; }

    const cfm = findConfirmDialog();
    if (cfm) {
      const ok = findBtn([/确\s*定/, /^确认$/], [/取消/], cfm);
      if (ok) {
        log('✅ 确认弹窗: 点确定');
        clickCenter(ok);
        lastSnapshot = '';
      }
      return;
    }

    switch (state) {
      case S.IDLE: {
        // 1) 评论/讨论题：输入 "." 并发送，发完一次就跳节
        //    必须在录音题之前判断，否则评论题会被误判为录音题
        if (isCommentArea() && Date.now() - lastCommentSentAt > 30000) {
          // 没内容 → 填入 "."；有内容 → 直接发送
          const inputs = findCommentInputs();
          const hasContent = inputs.some((el) => {
            if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') return !!el.value;
            return !!elText(el).trim();
          });
          if (!hasContent) {
            if (fillComment()) { setState(S.SETTLE); return; }
          } else {
            if (submitComment()) { 
              lastCommentSentAt = Date.now(); 
              // 评论已发送，直接跳下一节菜单项
              log('💬 评论已发送，跳转下一节');
              setState(S.SETTLE); 
              return; 
            }
          }
          // 评论题无法操作，直接跳下一节
          if (clickNext()) { setState(S.SETTLE); return; }
          // 如果已经在评论区发了评论，直接跳菜单
          if (lastCommentSentAt && Date.now() - lastCommentSentAt < 30000) {
            if (clickNextMenuItem()) { setState(S.SETTLE); return; }
          }
        }
        // 如果刚发完评论（30秒内），优先跳菜单
        if (Date.now() - lastCommentSentAt < 30000) {
          if (clickNextMenuItem()) { setState(S.SETTLE); return; }
          if (clickNext()) { setState(S.SETTLE); return; }
        }
        // 3) 录音题
        if (findRecordButton()) {
          state = S.RECORDING;
          log('发现录音题');
          return;
        }
        // 4) 选择题/判断题/填空题
        if (answerQuiz()) { setState(S.SETTLE); return; }
        // 5) 下一节 / tab / 菜单
        if (clickNext()) { setState(S.SETTLE); return; }
        if (clickNextTab()) { setState(S.SETTLE); return; }
        if (clickNextMenuItem()) { setState(S.SETTLE); }
        break;
      }
      case S.PLAYING_MEDIA: {
        // 视频正在播放中，检查是否播完
        if (allMediaEnded() || Date.now() > mediaWaitUntil) {
          log('📺 视频/音频播放完成');
          mediaWaitUntil = 0;
          setState(S.SETTLE);
        }
        // 否则继续等待（每轮 tick 都检查进度）
        break;
      }
      case S.RECORDING: {
        if (clickRecord()) {
          recordStart = Date.now();
          state = S.WAITING;
        } else {
          state = S.IDLE;
        }
        break;
      }
      case S.WAITING: {
        const dur = Date.now() - recordStart;
        const stopBtn = findStopButton();
        if (dur > CONFIG.recordMaxWaitMs) {
          log('⚠ 录音超时，尝试结束');
          if (clickStop()) { recordIdx++; state = S.SETTLE; } else { state = S.IDLE; noProgress = 0; }
        } else if (stopBtn && dur > CONFIG.recordMinDurationMs) {
          if (clickStop()) { recordIdx++; state = S.SETTLE; setTimeout(() => { lastSnapshot = ''; }, CONFIG.settleWaitMs); }
        }
        break;
      }
      case S.SETTLE: {
        // SETTLE 阶段：如果刚填完评论，先发送，发送成功后直接跳下一节
        let acted = false;
        if (commentFilled) {
          acted = submitComment();
          if (acted) {
            commentFilled = false;
            lastCommentSentAt = Date.now();
            // 评论已发送，下一轮直接跳下一节菜单项
            setTimeout(() => { setState(S.IDLE); }, CONFIG.settleWaitMs);
            break;
          }
          // 发送失败（按钮 disabled），回到 IDLE 重新触发 input
          setTimeout(() => { setState(S.IDLE); }, CONFIG.settleWaitMs);
          break;
        }
        // 如果刚发完评论，优先跳菜单
        if (Date.now() - lastCommentSentAt < 30000) {
          acted = clickNextMenuItem();
          if (!acted) acted = clickNext();
        }
        // 非评论场景：继续/下一节/tab/菜单
        if (!acted) acted = clickContinue();
        if (!acted) acted = clickNext();
        if (!acted) acted = clickNextTab();
        if (!acted) acted = clickNextMenuItem();
        if (!acted) {
          setTimeout(() => { setState(S.IDLE); }, CONFIG.settleWaitMs);
        } else {
          noProgress = 0;
          setTimeout(() => { setState(S.IDLE); }, CONFIG.nextCooldownMs);
        }
        break;
      }
    }
  }

  /* ============ 启动 ============ */
  if (window.onurlchange === undefined) {
    window.addEventListener('hashchange', () => { lastSnapshot = ''; noProgress = 0; recordIdx = 0; triedMenuItems = {}; lastMenuTarget = { text: '', at: 0 }; log('URL 变化，重置扫描'); });
  } else {
    window.addEventListener('urlchange', () => { lastSnapshot = ''; noProgress = 0; recordIdx = 0; triedMenuItems = {}; lastMenuTarget = { text: '', at: 0 }; log('URL 变化，重置扫描'); });
  }

  if (document.body) start();
  else document.addEventListener('DOMContentLoaded', start);
})();
